{
  "name": "subscription-manager",
  "version": "3.0.0",
  "description": "订阅管理系统 - 基于 Cloudflare Workers + Hono",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "setup": "node scripts/setup-kv.cjs",
    "deploy": "npx wrangler deploy",
    "deploy:safe": "npm run setup && npm run deploy",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "check:storage": "npm run build >/dev/null 2>&1 && node scripts/check-storage.mjs",
    "dev": "wrangler dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.18",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "vitest": "~2.1.9",
    "wrangler": "^3.99.0"
  },
  "keywords": [
    "cloudflare-workers",
    "subscription-management",
    "notification",
    "lunar-calendar",
    "hono"
  ],
  "license": "MIT"
}