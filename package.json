{
  "name": "subscription-manager",
  "version": "3.0.0",
  "description": "SubsTracker — a timed-trigger platform with subscriptions as the first plugin. One TypeScript codebase for Cloudflare Workers + KV and self-hosted Node + SQLite, with a reminder rule engine and 11 notification channels.",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "setup": "node scripts/setup-kv.cjs",
    "deploy": "npx wrangler deploy",
    "deploy:safe": "npm run setup && npm run deploy",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "check:storage": "npm run build && node scripts/check-storage.mjs",
    "check:server": "npm run build && node scripts/check-server.mjs",
    "check:setup": "node --test scripts/setup-kv.test.cjs",
    "check:ui": "node --test tests/node/*.test.cjs",
    "dev": "wrangler dev"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "vitest": "~2.1.9",
    "wrangler": "^3.99.0"
  },
  "keywords": [
    "cloudflare-workers",
    "self-hosted",
    "subscription-management",
    "notification",
    "reminder",
    "lunar-calendar",
    "sqlite",
    "typescript",
    "hono"
  ],
  "license": "MIT"
}
